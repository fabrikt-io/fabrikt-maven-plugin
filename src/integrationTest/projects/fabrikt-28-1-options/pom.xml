<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.fabrikt.test</groupId>
    <artifactId>fabrikt-28-1-options</artifactId>
    <version>1.0.0</version>

    <pluginRepositories>
        <pluginRepository>
            <id>fabrikt-integration-test</id>
            <url>@TEST_REPOSITORY@</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>io.fabrikt</groupId>
                <artifactId>fabrikt-maven-plugin</artifactId>
                <version>@FABRIKT_VERSION@</version>
                <executions>
                    <execution>
                        <id>generate-directional-models</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputFile>src/main/openapi/directional.yaml</inputFile>
                            <arguments>
                                <basePackage>com.example.directional</basePackage>
                                <targets>
                                    <value>http_models</value>
                                </targets>
                                <httpModelOpts>
                                    <value>REQUEST_RESPONSE_MODELS</value>
                                </httpModelOpts>
                                <dependenciesGenerationMode>MAVEN_NOTATION</dependenciesGenerationMode>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-composition-contracts</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputFile>src/main/openapi/composition.yaml</inputFile>
                            <arguments>
                                <basePackage>com.example.composition</basePackage>
                                <targets>
                                    <value>http_models</value>
                                </targets>
                                <httpModelOpts>
                                    <value>SHARED_COMPOSITION_CONTRACTS</value>
                                </httpModelOpts>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-api-key-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputFile>src/main/openapi/api-key.yaml</inputFile>
                            <arguments>
                                <basePackage>com.example.security</basePackage>
                                <targets>
                                    <value>client</value>
                                </targets>
                                <httpClientOpts>
                                    <value>OPENAPI_API_KEY_AUTHENTICATION</value>
                                </httpClientOpts>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
